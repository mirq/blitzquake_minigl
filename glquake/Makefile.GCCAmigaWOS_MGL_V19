#
# Quake GLQuake for Amiga WarpOS/PPC (GCC + MiniGL V19 dispatch client)
#
# Cross-compiles with ppc-amigaos-gcc + the MOS2WOS WarpOS SDK overlay,
# linking the MiniGL V19 WarpOS client archive (libminigl.a) which loads
# minigl_ppc.dll (R200 direct-Radeon stack) at runtime.
#
# Produces an ET_REL .warpelf that must be converted to a WarpOS executable
# ON THE AMIGA with target-hosted Elf2Exe2 (needs ixemul.library V48):
#   Stack 100000
#   Elf2Exe2 glquake_wos.warpelf glquakeWOS
#
# Deploy glquakeWOS + minigl_ppc.dll into the same directory (e.g.
# Work:games/quake). Runtime protocol: cold boot, C:InitPPC once per boot,
# then "Run >NIL: Execute DH2:ibdraw/hostrun" before every client run.
#
# Based on Makefile.GCCAmiga68k_MiniGLDispatch (68k dispatch client) and the
# MiniGL tree's Makefile.import.gcc (WarpOS ET_REL link contract).
#

VERSION=1.09

# MiniGL V19 WarpOS tree: headers (include/), client archive
# (lib/libminigl.a) and the shared WarpOS GCC config.
MGL_DIR ?= /home/mirek/MiniGL_WOS_V19_mglQ3
CPU ?= 604e
include $(MGL_DIR)/Makefile.wos.gcc.common

ARCH=warpos_gcc_v19/glquake
BUILDDIR=$(ARCH)

MINIGL_INC = -I$(MGL_DIR)/include

CFLAGS = -std=gnu89 $(WOS_ARCH_CFLAGS) -O2 -ffast-math -fomit-frame-pointer -w \
	-DWOS -DAMIGA -DGLQUAKE -DNOMOUSEASM -DFASTBOPS -DLITFILES -DGLOWEFFECTS \
	-DMINIGL_DISPATCH_CLIENT -Dstricmp=strcasecmp -DNDEBUG \
	$(MINIGL_INC) $(WOS_CPPFLAGS)

# Load the MiniGL DLL from the authoritative dev location instead of CWD
# (a stale copy in the game dir once silently resurrected fixed defects).
MGL_DLL_OVERRIDE ?= Work:ibdraw/minigl_ppc.dll

NETINC = -I$(WOS_SDK_ROOT)/netinclude

DO_CC=$(CC) $(CFLAGS) -o $@ -c $<
DO_CCNET=$(CC) $(CFLAGS) $(NETINC) -o $@ -c $<


#############################################################################
# SETUP AND BUILD
#############################################################################

TARGETS=$(BUILDDIR)/glquake_wos.warpelf

.PHONY: all clean check-tools

all: check-tools $(TARGETS)

check-tools:
	test -x "$(CC)"
	test -f "$(WOS_STARTFILE)"
	test -f "$(MGL_DIR)/include/proto/minigl.h"
	test -f "$(MGL_DIR)/lib/libminigl.a"

$(BUILDDIR):
	mkdir -p $(BUILDDIR)


