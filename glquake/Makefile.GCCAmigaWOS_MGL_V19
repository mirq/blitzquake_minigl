INCS = quakedef.h \
       common.h bspfile.h vid.h sys.h \
       zone.h mathlib.h wad.h draw.h \
       cvar.h screen.h net.h protocol.h \
       cmd.h sbar.h sound.h render.h \
       client.h progs.h server.h \
       gl_model.h input.h \
       world.h keys.h console.h location.h \
       view.h menu.h crc.h cdaudio.h \
       pr_comp.h progdefs.h modelgen.h spritegn.h glquake.h \
       miniglclient.h


$(BUILDDIR)/glquake_wos.warpelf: $(QUAKE_OBJS) $(MGL_DIR)/lib/libminigl.a $(WOS_ETREL_LDSCRIPT) | $(BUILDDIR)
	$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $(QUAKE_OBJS) $(MGL_DIR)/lib/libminigl.a \
		$(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)
	$(call WOS_VALIDATE_ETREL,$@)

##

# Default rule: X.o from X.c
$(BUILDDIR)/%.o : %.c $(INCS) | $(BUILDDIR)
	$(DO_CC)

# Files with non-default source mapping (same as historic WOS builds)

# Compile the archive's MiniGLOpen wrapper ourselves with the DLL path
# override; linked ahead of libminigl.a it replaces the archive member
# (whose DLL name is baked in at archive-build time).
$(BUILDDIR)/minigl_ppc_open.o : $(MGL_DIR)/client/minigl_ppc_open.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -I$(MGL_DIR)/hyperion_dll \
	  -DMINIGL_PPC_DLLNAME="\"$(MGL_DLL_OVERRIDE)\"" \
	  -o $@ -c $<

