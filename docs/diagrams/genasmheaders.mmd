flowchart LR
    SRC["genasmheaders.c"] --> TOOL["genasmheaders binary<br/>(host or target)"]
    CMD["*.gen command files<br/>#h headers, #s struct pairs"] --> TOOL
    TOOL --> TMP["temporary T:gendefs.c<br/>offsetof() / sizeof()"]
